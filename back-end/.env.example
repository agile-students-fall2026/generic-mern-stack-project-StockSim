PORT=3001
# Server-only; obtain your own free provider key. Never use a VITE_ variable.
ALPHA_VANTAGE_API_KEY=

# Optional in development; required with at least 32 random bytes in production.
JWT_SECRET=
FRONTEND_ORIGIN=http://localhost:5173

# Leave SMTP_HOST empty for private local previews in back-end/.mail/ (development only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=StockSim <no-reply@stocksim.local>
