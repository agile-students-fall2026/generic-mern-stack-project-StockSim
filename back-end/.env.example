PORT=3001
# Server-only; obtain your own free provider key. Never use a VITE_ variable.
ALPHA_VANTAGE_API_KEY=

# Optional in development; required with at least 32 random bytes in production.
JWT_SECRET=
FRONTEND_ORIGIN=http://localhost:5173

# Leave SMTP_HOST empty for private local previews in back-end/.mail/ (development only).
# For a browser test inbox, use smtp.ethereal.email:587 and your own generated
# Ethereal credentials in .env. Set MAIL_FROM to that account (see README).
# Ethereal captures mail; it does not deliver to Gmail. Never commit credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=StockSim <no-reply@stocksim.local>

# Optional for the old practice demo; required for persistent accounts and watchlists.
MONGODB_URI=
